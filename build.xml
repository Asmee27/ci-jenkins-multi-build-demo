<project name="ci-jenkins-demo" default="build" basedir=".">
    <property name="src.dir" value="src/main/java"/>
    <property name="test.dir" value="src/test/java"/>
    <property name="build.dir" value="ant-build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="dist.dir" value="${build.dir}/dist"/>

    <target name="clean">
        <delete dir="${build.dir}"/>
    </target>

    <target name="compile" depends="clean">
        <mkdir dir="${classes.dir}"/>
        <javac srcdir="${src.dir}" destdir="${classes.dir}" release="21" includeantruntime="false"/>
        <javac srcdir="${test.dir}" destdir="${classes.dir}" release="21" includeantruntime="false"/>
    </target>

    <target name="test" depends="compile">
        <java classname="com.vit.demo.AppTest" classpath="${classes.dir}" failonerror="true"/>
    </target>

    <target name="build" depends="test">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.dir}/ci-jenkins-demo-1.0.0.jar" basedir="${classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="com.vit.demo.App"/>
            </manifest>
        </jar>
        <echo message="ANT BUILD SUCCESSFUL"/>
    </target>
</project>